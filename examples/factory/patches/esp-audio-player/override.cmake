# Keep the esp-audio-player 1.1.0 MP3 recovery fix in the project, so a
# Component Manager refresh cannot overwrite it. Other player sources stay upstream.
if(CONFIG_AUDIO_PLAYER_ENABLE_MP3)
    idf_component_get_property(_audio_player_lib chmorgan__esp-audio-player COMPONENT_LIB)
    idf_component_get_property(_audio_player_dir chmorgan__esp-audio-player COMPONENT_DIR)
    get_target_property(_audio_player_sources ${_audio_player_lib} SOURCES)
    set(_audio_player_replaced_count 0)
    set(_audio_player_remaining_sources "")
    foreach(_source IN LISTS _audio_player_sources)
        get_filename_component(_source_name "${_source}" NAME)
        if(_source_name STREQUAL "audio_mp3.cpp")
            math(EXPR _audio_player_replaced_count "${_audio_player_replaced_count} + 1")
        else()
            list(APPEND _audio_player_remaining_sources "${_source}")
        endif()
    endforeach()
    if(NOT _audio_player_replaced_count EQUAL 1)
        message(FATAL_ERROR "Expected one esp-audio-player MP3 source; review the local recovery fix after upgrading the player")
    endif()
    set_property(TARGET ${_audio_player_lib} PROPERTY SOURCES "${_audio_player_remaining_sources}")
    target_sources(${_audio_player_lib} PRIVATE "${CMAKE_CURRENT_LIST_DIR}/audio_mp3.cpp")
    target_include_directories(${_audio_player_lib} PRIVATE "${_audio_player_dir}")
endif()
